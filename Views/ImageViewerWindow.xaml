<Window
    x:Class="PlustekBCR.Views.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              MinHeight="56"
              Padding="16,10"
              ColumnSpacing="12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="FrontSideButton" Click="OnFrontSideClicked" MinWidth="88"/>
                <ToggleButton x:Name="BackSideButton" Click="OnBackSideClicked" MinWidth="88"/>
            </StackPanel>

            <TextBlock x:Name="CardNameText"
                       Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ZoomOutButton" Click="OnZoomOutClicked" Width="36" MinWidth="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE738;" FontSize="14"/>
                </Button>
                <TextBlock x:Name="ZoomText"
                           Width="56"
                           HorizontalTextAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button x:Name="ZoomInButton" Click="OnZoomInClicked" Width="36" MinWidth="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
                <Button x:Name="ActualSizeButton" Click="OnActualSizeClicked" MinWidth="56" Height="36" Padding="8,0" Content="100%"/>
                <Button x:Name="FitButton" Click="OnFitClicked" Width="36" MinWidth="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE9A6;" FontSize="15"/>
                </Button>
                <ToggleButton x:Name="AlwaysOnTopButton" Click="OnAlwaysOnTopClicked" Width="36" MinWidth="36" Height="36" Padding="0">
                    <FontIcon Glyph="&#xE840;" FontSize="15"/>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <Grid x:Name="ViewportGrid"
              Grid.Row="1"
              Background="#FF202124"
              SizeChanged="OnViewportSizeChanged"
              PointerWheelChanged="OnViewportPointerWheelChanged"
              PointerPressed="OnViewportPointerPressed"
              PointerMoved="OnViewportPointerMoved"
              PointerReleased="OnViewportPointerReleased"
              PointerCaptureLost="OnViewportPointerCaptureLost">
            <Canvas x:Name="ImageCanvas">
                <Image x:Name="ViewerImage"
                       Stretch="Fill"/>
            </Canvas>
        </Grid>
    </Grid>
</Window>
