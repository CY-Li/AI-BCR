<Page
    x:Class="PlustekBCR.Views.CardDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PlustekBCR.Models"
    xmlns:viewmodels="using:PlustekBCR.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Page.Resources>
        <CollectionViewSource x:Name="GroupedCardsSource" 
                              IsSourceGrouped="True" 
                              Source="{x:Bind ViewModel.GroupedCards, Mode=OneWay}"/>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageRootTranslate"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sider: Card List Thumbnails -->
        <Border Grid.Column="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind GroupedCardsSource.View, Mode=OneWay}"
                      SelectionMode="Single"
                      SelectedItem="{x:Bind ViewModel.SelectedCard, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource CardListViewItemStyle}"
                      Padding="0,0,0,24">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BusinessCard">
                        <Grid Padding="8" Background="Transparent" HorizontalAlignment="Stretch">
                            <Border HorizontalAlignment="Stretch" Height="140" CornerRadius="6" 
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                    ToolTipService.ToolTip="{x:Bind FullName}">
                                <Image Source="{x:Bind FrontImageData, Converter={StaticResource ByteArrayToImageSourceConverter}, ConverterParameter=816, Mode=OneWay}" 
                                       Stretch="Uniform" Margin="8"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderContainerStyle>
                            <StaticResource ResourceKey="CardDetailListGroupHeaderItemStyle"/>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:CardGroup">
                                <TextBlock Text="{x:Bind Key}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                           CharacterSpacing="50"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,20,32,48" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header: Name and Actions -->
                    <RowDefinition Height="Auto"/> <!-- Top: Card Images -->
                    <RowDefinition Height="*"/>    <!-- Bottom: Details and Notes -->
                </Grid.RowDefinitions>

                <!-- Header: Card Name and Delete Card Action -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Click="OnBackClicked"
                            Style="{StaticResource DetailBackButtonStyle}"
                            VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCard.FullName, Mode=OneWay}" FontSize="28" FontWeight="Bold"/>
                        <Border Style="{StaticResource BcrStatusPillBorderStyle}" Background="{x:Bind ViewModel.SelectedCard.Status, Converter={StaticResource StatusToBackgroundBrushConverter}, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedCard.Status, Converter={StaticResource StatusToStringConverter}, Mode=OneWay}" 
                                       Style="{StaticResource BcrStatusPillTextStyle}"
                                       Foreground="{x:Bind ViewModel.SelectedCard.Status, Converter={StaticResource StatusToForegroundBrushConverter}, Mode=OneWay}"
                                       />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReprocessAiButton"
                                Style="{StaticResource HeaderActionIconButtonStyle}"
                                ToolTipService.ToolTip="{Binding [View.CardDetail.ReprocessAi]}"
                                IsEnabled="{x:Bind ViewModel.SelectedCard.IsAiReprocessAvailable, Mode=OneWay}"
                                Click="OnAiReprocessClicked">
                            <Grid>
                                <Viewbox Width="27" Height="27" Stretch="Uniform"
                                         Visibility="{x:Bind ViewModel.SelectedCard.IsRecognizing, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}">
                                    <Grid Width="24" Height="24">
                                        <Path Data="M8,4 L6.5,4 C5.12,4 4,5.12 4,6.5 L4,8 M16,4 L17.5,4 C18.88,4 20,5.12 20,6.5 L20,8 M4,16 L4,17.5 C4,18.88 5.12,20 6.5,20 L8,20 M20,16 L20,17.5 C20,18.88 18.88,20 17.5,20 L16,20"
                                              Stroke="{StaticResource BrandBlueBrush}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Path Data="M12,7.25 C12.45,9.2 13.8,10.55 15.75,11 C13.8,11.45 12.45,12.8 12,14.75 C11.55,12.8 10.2,11.45 8.25,11 C10.2,10.55 11.55,9.2 12,7.25 Z"
                                              Stroke="{StaticResource BrandBlueBrush}" StrokeThickness="1.55"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Path Data="M16.7,13.9 C16.88,14.68 17.42,15.22 18.2,15.4 C17.42,15.58 16.88,16.12 16.7,16.9 C16.52,16.12 15.98,15.58 15.2,15.4 C15.98,15.22 16.52,14.68 16.7,13.9 Z"
                                              Fill="{StaticResource BrandBlueBrush}"/>
                                    </Grid>
                                </Viewbox>
                                <ProgressRing IsActive="True"
                                              Width="18"
                                              Height="18"
                                              Foreground="{StaticResource BrandBlueBrush}"
                                              Visibility="{x:Bind ViewModel.SelectedCard.IsRecognizing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                              MinHeight="0"
                                              MinWidth="0"
                                              BorderThickness="1.5"/>
                            </Grid>
                        </Button>

                        <Button x:Name="DeleteCardButton"
                                Style="{StaticResource HeaderActionIconButtonStyle}"
                                ToolTipService.ToolTip="{Binding [View.CardDetail.DeleteCard]}"
                                Command="{x:Bind ViewModel.DeleteCardCommand}"
                                CommandParameter="{x:Bind ViewModel.SelectedCard, Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Top: Front and Back Thumbnails -->
                <Grid Grid.Row="1" Margin="48,0,0,0" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="16">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header with Buttons -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="{Binding [View.CardDetail.FrontSide]}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button ToolTipService.ToolTip="Add front image" 
                                            Style="{StaticResource HeaderIconButtonStyle}" Width="32" Height="32" 
                                            Visibility="{x:Bind ViewModel.SelectedCard.FrontImageData, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <Button.Flyout>
                                            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource BcrTagMenuFlyoutPresenterStyle}" Opening="OnImageActionFlyoutOpening">
                                                <MenuFlyoutItem Text="{Binding [Button.UploadFromFile]}" Click="OnUploadFrontFileClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE710;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{Binding [Button.ScanFromScanner]}" Click="OnScanFrontClicked">
                                                    <MenuFlyoutItem.Icon>
