                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{x:Bind CreatedAt, Converter={StaticResource DateTimeToStringConverter}}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Row="0"
                                                            Grid.RowSpan="2"
                                                            Grid.Column="1"
                                                            Width="28"
                                                            Height="28"
                                                            Padding="0"
                                                            Margin="8,-6,-6,0"
                                                            VerticalAlignment="Top"
                                                            Style="{StaticResource HeaderIconButtonStyle}"
                                                            ToolTipService.ToolTip="{Binding DataContext[Button.Delete], ElementName=PageRoot}"
                                                            AutomationProperties.Name="{Binding DataContext[Button.Delete], ElementName=PageRoot}"
                                                            Click="OnDeleteNoteClicked">
                                                        <FontIcon Glyph="&#xE74D;"
                                                                  FontSize="12"
                                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </Button>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="0"
                                                               Text="{x:Bind Content}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14"
                                                               LineHeight="20"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            
                            <Grid Grid.Row="2" Margin="0,16,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Height="40">
                                    <TextBox x:Name="NewNoteTextBox"
                                             Text="{x:Bind ViewModel.NewNoteContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="40"
                                             Padding="12,8,32,8"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnNewNoteTextBoxTextChanged"
                                             KeyDown="OnNewNoteTextBoxKeyDown"/>
                                    <TextBlock x:Name="NewNotePlaceholderText"
                                               Text="{Binding [Placeholder.NewNote]}"
                                               Margin="12,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AddNoteCommand}" 
                                        Style="{StaticResource AccentButtonStyle}" Width="40" Height="40" Padding="0">
                                    <FontIcon Glyph="&#xE724;" FontSize="16"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

