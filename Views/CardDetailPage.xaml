                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    </Button>
                                    <Button x:Name="DeleteBackImageButton" Click="OnDeleteBackClicked" ToolTipService.ToolTip="{Binding [View.CardDetail.DeleteBackImage]}" 
                                            Style="{StaticResource HeaderIconButtonStyle}" Width="32" Height="32" 
                                            Visibility="{x:Bind ViewModel.SelectedCard.BackImageData, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Image Container / Empty State -->
                            <Border x:Name="BackImageBorder"
                                    Grid.Row="1"
                                    Height="260"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="12"
                                    Tapped="OnOpenBackImageViewerClicked"
                                    ToolTipService.ToolTip="{Binding [View.ImageViewer.Open]}">
                                <Grid AllowDrop="True" Background="Transparent" DragEnter="OnImageDragOver" DragOver="OnImageDragOver" DragLeave="OnImageDragLeave" Drop="OnBackImageDrop">
                                    <!-- Image if exists -->
                                    <Image Source="{x:Bind ViewModel.SelectedCard.BackImageData, Converter={StaticResource ByteArrayToImageSourceConverter}, Mode=OneWay}" 
                                           Stretch="Uniform" Margin="12"
                                           Visibility="{x:Bind ViewModel.SelectedCard.BackImageData, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                           IsHitTestVisible="False"/>
                                    
                                    <!-- Empty State prompt -->
                                    <Button Style="{StaticResource ImageEmptyStateButtonStyle}"
                                            Visibility="{x:Bind ViewModel.SelectedCard.BackImageData, Converter={StaticResource InvertedBoolToVisibilityConverter}, Mode=OneWay}">
                                        <Button.Flyout>
                                            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource BcrTagMenuFlyoutPresenterStyle}" Opening="OnImageActionFlyoutOpening">
                                                <MenuFlyoutItem Text="{Binding [Button.UploadFromFile]}" Click="OnUploadBackFileClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE710;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
