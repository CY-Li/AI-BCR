                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                                            <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <PathIcon Data="M2.747 15a.75.75 0 0 1 .743.648l.007.102v3.502l.007.128a1.25 1.25 0 0 0 1.115 1.116l.128.006h3.5l.102.007a.75.75 0 0 1 0 1.486l-.102.007h-3.5l-.167-.005a2.75 2.75 0 0 1-2.578-2.57l-.005-.175V15.75l.007-.102A.75.75 0 0 1 2.747 15Zm18.5 0a.75.75 0 0 1 .743.648l.007.102v3.502a2.75 2.75 0 0 1-2.582 2.745l-.168.005h-3.5a.75.75 0 0 1-.102-1.493l.102-.007h3.5a1.25 1.25 0 0 0 1.244-1.122l.006-.128V15.75a.75.75 0 0 1 .75-.75Zm-8.992.5a.75.75 0 0 1 .102 1.493l-.102.007H7.75a.75.75 0 0 1-.102-1.493l.102-.007h4.505Zm3.995-4.25a.75.75 0 0 1 .102 1.493l-.102.007h-8.5a.75.75 0 0 1-.102-1.493l.102-.007h8.5ZM8.247 2a.75.75 0 0 1 .102 1.493l-.102.007h-3.5a1.25 1.25 0 0 0-1.243 1.122l-.007.128v3.502a.75.75 0 0 1-1.493.102l-.007-.102V4.75A2.75 2.75 0 0 1 4.58 2.005L4.747 2h3.5Zm11 0 .168.005a2.75 2.75 0 0 1 2.577 2.57l.005.175v3.502l-.007.102a.75.75 0 0 1-1.486 0l-.007-.102V4.75l-.006-.128a1.25 1.25 0 0 0-1.116-1.116l-.128-.006h-3.5l-.102-.007a.75.75 0 0 1 0-1.486L15.747 2h3.5ZM16.25 7a.75.75 0 0 1 .102 1.493l-.102.007h-8.5a.75.75 0 0 1-.102-1.493L7.75 7h8.5Z"
                                                          Width="24"
                                                          Height="24"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding [View.CardDetail.DropFrontImage]}" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="FrontScanLoadingOverlay"
                                            Background="#B31C1C1C"
                                            CornerRadius="12"
                                            Visibility="Collapsed"
                                            IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                            <ProgressRing IsActive="True" Width="36" Height="36"/>
                                            <TextBlock Text="{Binding [View.CardDetail.ScanningFront]}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="16">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header with Buttons -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="{Binding [View.CardDetail.BackSide]}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button ToolTipService.ToolTip="Add back image" 
                                            Style="{StaticResource HeaderIconButtonStyle}" Width="32" Height="32" 
                                            Visibility="{x:Bind ViewModel.SelectedCard.BackImageData, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                        <Button.Flyout>
                                            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource BcrTagMenuFlyoutPresenterStyle}" Opening="OnImageActionFlyoutOpening">
                                                <MenuFlyoutItem Text="{Binding [Button.UploadFromFile]}" Click="OnUploadBackFileClicked">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE710;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
