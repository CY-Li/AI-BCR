<Page
    x:Class="PlustekBCR.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PlustekBCR.Controls"
    xmlns:viewmodels="using:PlustekBCR.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,20,32,56"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="14">
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource DetailBackButtonStyle}"
                        Click="OnBackToCardsClicked"/>

                <StackPanel Margin="48,0,0,0" Spacing="6">
                    <TextBlock x:Name="SectionTitleTextBlock"
                               Text="{Binding [Settings.General.Title]}"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SectionDescriptionTextBlock"
                               Text="{Binding [Settings.General.Description]}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="GeneralContentPanel"
                  Grid.Row="1"
                  Margin="48,26,0,0"
                  HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SettingsLayoutStates">
                        <VisualState x:Name="NarrowLayout"/>
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="800"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="MarketControlHost.(Grid.Row)" Value="0"/>
                                <Setter Target="MarketControlHost.(Grid.Column)" Value="1"/>
                                <Setter Target="MarketControlHost.Margin" Value="32,0,0,0"/>
                                <Setter Target="UiLanguageControlHost.(Grid.Row)" Value="0"/>
                                <Setter Target="UiLanguageControlHost.(Grid.Column)" Value="1"/>
                                <Setter Target="UiLanguageControlHost.Margin" Value="32,0,0,0"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="12"
                                    Background="{ThemeResource SettingsSelectionBackgroundBrush}">
                                <FontIcon Glyph="&#xE775;"
                                          FontSize="18"
                                          Foreground="{ThemeResource SettingsSelectionBorderBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{Binding [Settings.LanguageRegion.Title]}"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.LanguageRegion.Description]}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Grid x:Name="MarketSettingRow">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [Settings.Market.Title]}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Market.Description]}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <Grid x:Name="MarketControlHost" Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <ComboBox x:Name="LanguageComboBox"
                                          Style="{StaticResource BcrComboBoxStyle}"
                                          Width="280"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnLanguageSelectionChanged"/>
                            </Grid>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Grid x:Name="UiLanguageSettingRow">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding [Settings.UiLanguage.Title]}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.UiLanguage.Description]}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <Grid x:Name="UiLanguageControlHost" Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                <ComboBox x:Name="UiLanguageComboBox"
                                          Style="{StaticResource BcrComboBoxStyle}"
                                          Width="280"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnUiLanguageSelectionChanged"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="{ThemeResource SettingsSelectionBackgroundBrush}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource SettingsSelectionBorderBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{Binding [Settings.Duplicate.Title]}" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Duplicate.Description]}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <Border Grid.Column="2" Padding="10,5" CornerRadius="12" Background="{ThemeResource SettingsSelectionBackgroundBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind DuplicateViewModel.SelectedFieldCountText, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource SettingsSelectionForegroundBrush}"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Duplicate.Presets.Title]}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Duplicate.Presets.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.Presets, Mode=OneWay}"
                                          ItemContainerStyle="{StaticResource SettingsStretchItemContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="10"
                                                            VerticalSpacing="10"
                                                            UseUniformItemWidth="True"
                                                            MinimumItemWidth="230"
                                                            MaximumColumns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicatePresetOption">
                                        <ToggleButton x:Name="PresetToggle"
                                                      Style="{StaticResource SettingsPresetCardStyle}"
                                                      IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                      Command="{x:Bind ApplyCommand}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           Opacity="0.72"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding [Settings.Duplicate.Fields]}" FontSize="15" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.FieldGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicateFieldGroup">
                                        <StackPanel Spacing="8" Margin="0,0,0,14">
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{x:Bind Fields}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:DuplicateFieldOption">
                                                        <ToggleButton Content="{x:Bind Label}"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      Style="{StaticResource SettingsChoiceChipStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="{Binding [Settings.Duplicate.Group.Advanced]}" HorizontalAlignment="Stretch">
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Bind DuplicateViewModel.AdvancedFields, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DuplicateFieldOption">
                                            <ToggleButton Content="{x:Bind Label}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource SettingsChoiceChipStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Settings.Duplicate.Condition]}" FontSize="15" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.Operators, Mode=OneWay}"
                                          ItemContainerStyle="{StaticResource SettingsStretchItemContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="10"
                                                            VerticalSpacing="10"
                                                            UseUniformItemWidth="True"
                                                            MinimumItemWidth="320"
                                                            MaximumColumns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicateOperatorOption">
                                        <ToggleButton x:Name="OperatorToggle"
                                                      Style="{StaticResource SettingsRuleCardStyle}"
                                                      IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                      Command="{x:Bind SelectCommand}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           Opacity="0.72"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsInfoPanelStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding [Settings.Duplicate.CurrentRule]}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SettingsSelectionForegroundBrush}"/>
                                        <TextBlock Text="{x:Bind DuplicateViewModel.CurrentPresetText, Mode=OneWay}"
                                                   Foreground="{ThemeResource SettingsSelectionBorderBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DuplicateViewModel.RuleSummary, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource SettingsSelectionForegroundBrush}"
                                               Opacity="0.78"
                                               TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind DuplicateViewModel.SaveStatusText, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource SettingsSelectionForegroundBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{x:Bind DuplicateViewModel.ValidationMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind DuplicateViewModel.HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind DuplicateViewModel.SaveErrorMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind DuplicateViewModel.HasSaveError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="SectionHintBorder"
                    Grid.Row="2"
                    Margin="48,16,0,0"
                    Padding="16,12"
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="Collapsed">
                <TextBlock x:Name="SectionHintTextBlock"
                           Text="{Binding [Settings.General.Hint]}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
