<Page
    x:Class="PlustekBCR.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PlustekBCR.Controls"
    xmlns:viewmodels="using:PlustekBCR.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="32,20,32,56"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="14">
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource DetailBackButtonStyle}"
                        Click="OnBackToCardsClicked"/>

                <StackPanel Margin="48,0,0,0" Spacing="6">
                    <TextBlock x:Name="SectionTitleTextBlock"
                               Text="{Binding [Settings.General.Title]}"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="SectionDescriptionTextBlock"
                               Text="{Binding [Settings.General.Description]}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </StackPanel>

            <Grid x:Name="GeneralContentPanel"
                  Grid.Row="1"
                  Margin="48,26,0,0"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="LanguageSettingsCard" Grid.Row="0" Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Settings.Language.Title]}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Language.Description]}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ComboBox x:Name="UiLanguageComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource BcrComboBoxStyle}"
                                  Width="280"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="OnUiLanguageSelectionChanged"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="DuplicateSettingsCard" Grid.Row="1" Spacing="12">
                        <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding [Settings.Duplicate.Presets.Title]}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Duplicate.Presets.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.Presets, Mode=OneWay}"
                                          ItemContainerStyle="{StaticResource SettingsStretchItemContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="10"
                                                            VerticalSpacing="10"
                                                            UseUniformItemWidth="True"
                                                            MinimumItemWidth="230"
                                                            MaximumColumns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicatePresetOption">
                                        <ToggleButton x:Name="PresetToggle"
                                                      Style="{StaticResource SettingsPresetCardStyle}"
                                                      IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                      Command="{x:Bind ApplyCommand}">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           Opacity="0.72"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings.Duplicate.Fields]}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="12" Background="{ThemeResource SettingsSelectionBackgroundBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DuplicateViewModel.SelectedFieldCountText, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SettingsSelectionForegroundBrush}"/>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.FieldGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicateFieldGroup">
                                        <StackPanel Spacing="8" Margin="0,0,0,14">
                                            <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{x:Bind Fields}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:DuplicateFieldOption">
                                                        <ToggleButton Content="{x:Bind Label}"
                                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                      Style="{StaticResource SettingsChoiceChipStyle}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="{Binding [Settings.Duplicate.Group.Advanced]}" HorizontalAlignment="Stretch">
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Bind DuplicateViewModel.AdvancedFields, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:DuplicateFieldOption">
                                            <ToggleButton Content="{x:Bind Label}"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Style="{StaticResource SettingsChoiceChipStyle}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Settings.Duplicate.Condition]}" FontSize="15" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{x:Bind DuplicateViewModel.Operators, Mode=OneWay}"
                                          ItemContainerStyle="{StaticResource SettingsStretchItemContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel HorizontalSpacing="10"
                                                            VerticalSpacing="10"
                                                            UseUniformItemWidth="True"
                                                            MinimumItemWidth="320"
                                                            MaximumColumns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DuplicateOperatorOption">
                                        <ToggleButton x:Name="OperatorToggle"
                                                      Style="{StaticResource SettingsRuleCardStyle}"
                                                      IsChecked="{x:Bind IsActive, Mode=OneWay}"
                                                      Command="{x:Bind SelectCommand}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="11"
                                                           Opacity="0.72"
                                                           TextWrapping="WrapWholeWords"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind DuplicateViewModel.ValidationMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind DuplicateViewModel.HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind DuplicateViewModel.SaveErrorMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   Visibility="{x:Bind DuplicateViewModel.HasSaveError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>

                <Border x:Name="RegionSettingsCard" Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Settings.Region.Title]}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Settings.Region.Description]}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="WrapWholeWords"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource BcrComboBoxStyle}"
                                  Width="280"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="OnLanguageSelectionChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="ScanContentPanel"
                  Grid.Row="1"
                  Margin="48,26,0,0"
                  HorizontalAlignment="Stretch"
                  Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.Scan.Resolution.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Scan.Resolution.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ScanViewModel.ResolutionOptions}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ScanResolutionOption">
                                        <ToggleButton Content="{x:Bind Label}"
                                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                      Command="{x:Bind SelectCommand}"
                                                      Style="{StaticResource SettingsChoiceChipStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.Scan.ColorMode.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Scan.ColorMode.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ScanViewModel.ColorModeOptions}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ScanColorModeOption">
                                        <ToggleButton Content="{x:Bind Label}"
                                                      IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                      Command="{x:Bind SelectCommand}"
                                                      Style="{StaticResource SettingsChoiceChipStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.Scan.AutoCrop.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Scan.AutoCrop.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ScanViewModel.AutoCrop, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.Scan.AutoDeskew.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Scan.AutoDeskew.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ScanViewModel.AutoDeskew, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.Scan.AutoRotate.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.Scan.AutoRotate.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ScanViewModel.AutoRotate, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Bind ScanViewModel.SaveErrorMessage, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind ScanViewModel.HasSaveError, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="AboutContentPanel"
                  Grid.Row="1"
                  Margin="48,26,0,0"
                  HorizontalAlignment="Stretch"
                  Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.About.Version.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.About.Version.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ApplicationVersion}"
                                       FontSize="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}" Translation="0,0,8">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings.About.Firmware.Title]}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [Settings.About.Firmware.Description]}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind FirmwareVersion}"
                                       FontSize="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="SectionHintBorder"
                    Grid.Row="2"
                    Margin="48,16,0,0"
                    Padding="16,12"
                    Style="{StaticResource SettingsCardStyle}"
                    Visibility="Collapsed">
                <TextBlock x:Name="SectionHintTextBlock"
                           Text="{Binding [Settings.General.Hint]}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
